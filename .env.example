# Copy to .env (never commit .env). Used by docker compose and the app.
# docker compose reads this repo-root .env by itself, only to fill in the ${...} values in
# docker-compose.yml; the app container receives just the variables listed there.
# When you run the app from backend/ (./mvnw spring-boot:run), Spring Boot auto-imports this
# repo-root .env as properties (spring.config.import in application.yml). Keep values unquoted.
POSTGRES_DB=carequeue
POSTGRES_USER=carequeue
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432
# Host port for the whole app (UI + API) with `docker compose up --build`: http://localhost:8080
APP_PORT=8080
# The app defaults to a localhost Postgres (jdbc:postgresql://localhost:5432/carequeue).
# These two are for running from backend/; the compose app service uses POSTGRES_USER/PASSWORD.
SPRING_DATASOURCE_USERNAME=carequeue
SPRING_DATASOURCE_PASSWORD=change-me-local

# Demo users (ADR-004)
CAREQUEUE_NURSE_PASSWORD=change-me
CAREQUEUE_MANAGER_PASSWORD=change-me

# Optional: real AI triage via Groq. Without it (blank), the rule-based fallback is used.
GROQ_API_KEY=
# Optional overrides. Leave them commented out to use the defaults: an empty value would
# replace the default with nothing.
# CAREQUEUE_TRIAGE_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1
